# Local development environment.
# Copy this file before starting anything:  cp .env.example .env
# .env is gitignored and must never be committed.

# --- PostgreSQL ---
POSTGRES_USER=expansa
POSTGRES_PASSWORD=expansa
POSTGRES_DB=expansa

# Host port for the containerised database.
# Ports 5432-5434 are occupied by system-installed PostgreSQL clusters (15, 16, 17)
# on this machine, and silently talking to the wrong database is an expensive
# mistake to diagnose.
POSTGRES_PORT=5435

# Used by the server, which runs inside the compose network and addresses the
# database by its service name.
DATABASE_URL=postgresql://expansa:expansa@postgres:5432/expansa

# The same database as seen from the host, for tools run outside the container
# (psql, GUI clients, one-off scripts):
#   postgresql://expansa:expansa@localhost:5435/expansa

# --- Server ---
SERVER_PORT=3000
