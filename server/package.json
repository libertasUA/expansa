{
  "name": "@expansa/server",
  "version": "0.0.0",
  "private": true,
  "description": "Expansa authoritative game server",
  "scripts": {
    "dev": "concurrently --kill-others --names tsc,app --prefix-colors blue,green \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.4",
    "typescript": "^5.9.3"
  }
}
