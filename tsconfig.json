{
  // Solution file. Holds no sources of its own — `tsc -b` reads the references
  // and builds each project after its dependencies.
  //
  // This is the second thing enforcing contour boundaries after pnpm: TypeScript
  // refuses to resolve a package that is not in a project's `references`, so a
  // Contour 2 engine cannot reach the platform layer even if someone adds the
  // dependency to package.json by hand.
  "files": [],
  "references": [
    { "path": "./kernel" },
    { "path": "./engines/quantity" },
    { "path": "./server" }
  ]
}
