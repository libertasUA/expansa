{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS, not ESM. The NestJS CLI, its watch mode, and decorator metadata
    // emission are all built around CJS; ESM support exists but is fragile enough
    // that it is not worth spending debugging budget on. Portable packages ship a
    // matching ESM build for client bundlers — see ADR 0003.
    "module": "commonjs",
    "moduleResolution": "node",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "./src"
  },
  "references": [
    { "path": "../../../packages/kernel" },
    { "path": "../../../packages/engines/quantity" },
    // Added with the move: the server imports @expansa/platform, so its watch
    // build has to rebuild it. Without this an edit in platform compiled only
    // when something else happened to run `tsc -b` from the root.
    { "path": "../platform" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
