{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS only. This package is server-bound by definition — it holds the
    // pool and the adapters — so there is nothing for a client bundler to want.
    "module": "commonjs",
    "moduleResolution": "node",

    // Required for project references: the server depends on this project and
    // `tsc -b` needs the emitted declarations plus a build info file.
    "composite": true,

    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../../../packages/kernel" }]
}
