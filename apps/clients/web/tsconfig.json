{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // ESM and bundler resolution: Vite consumes the ESM half of the portable
    // packages through their exports map, which is what that second build exists
    // for — see ADR 0004.
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
